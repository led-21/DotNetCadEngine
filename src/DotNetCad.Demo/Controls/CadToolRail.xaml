<UserControl x:Class="DotNetCad.Demo.Controls.CadToolRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="clr-namespace:DotNetCad.Core.Editor;assembly=DotNetCad.Core"
             Background="#1E293B">
    <UserControl.Resources>
        <Geometry x:Key="SelectIcon">M 4,3 L 4,18 L 9,14 L 12,21 L 15,19 L 12,13 L 18,13 Z</Geometry>
        <Geometry x:Key="LineIcon">M 4,19 L 20,5 M 2,17 L 6,17 L 6,21 L 2,21 Z M 18,3 L 22,3 L 22,7 L 18,7 Z</Geometry>
        <Geometry x:Key="PolylineIcon">M 3,18 L 9,6 L 15,15 L 21,5 M 1,16 L 5,16 L 5,20 L 1,20 Z M 7,4 L 11,4 L 11,8 L 7,8 Z M 13,13 L 17,13 L 17,17 L 13,17 Z M 19,3 L 23,3 L 23,7 L 19,7 Z</Geometry>
        <Geometry x:Key="RectangleIcon">M 3,5 L 21,5 L 21,19 L 3,19 Z M 1,3 L 5,3 L 5,7 L 1,7 Z M 19,17 L 23,17 L 23,21 L 19,21 Z</Geometry>
        <Geometry x:Key="CircleIcon">M 12,3 A 9,9 0 1 1 11.99,3 M 9,12 L 15,12 M 12,9 L 12,15</Geometry>
        <Geometry x:Key="DimensionIcon">M 4,5 L 4,19 M 20,5 L 20,19 M 5,12 L 19,12 M 5,12 L 8,10 M 5,12 L 8,14 M 19,12 L 16,10 M 19,12 L 16,14</Geometry>
        <Geometry x:Key="ArcIcon">M 4,18 A 12,12 0 0 1 18,4 M 3,17 L 5,17 L 5,19 L 3,19 Z M 17,3 L 19,3 L 19,5 L 17,5 Z</Geometry>
        <Geometry x:Key="PanIcon">M 12,2 L 12,10 M 8,5 L 8,12 M 16,5 L 16,12 M 5,9 L 5,14 C 5,18 8,21 12,21 C 16,21 19,18 19,14 L 19,9</Geometry>
        <Geometry x:Key="TextIcon">M 6,19 L 12,4 L 18,19 M 8,14 L 16,14</Geometry>
        <Geometry x:Key="OrthoIcon">M 4,20 L 4,5 L 20,5 M 4,16 L 8,16 L 8,20</Geometry>
        <Geometry x:Key="PolarIcon">M 3,20 L 21,20 M 3,20 L 17,6 M 8,20 A 5,5 0 0 0 6.5,16.5 M 17,4 L 19,6 L 17,8</Geometry>
        <Geometry x:Key="SnapIcon">M 12,2 L 12,8 M 12,16 L 12,22 M 2,12 L 8,12 M 16,12 L 22,12 M 12,8 A 4,4 0 1 1 11.99,8</Geometry>
        <Geometry x:Key="MoveIcon">M 12,2 L 12,22 M 2,12 L 22,12 M 12,2 L 9,5 M 12,2 L 15,5 M 12,22 L 9,19 M 12,22 L 15,19 M 2,12 L 5,9 M 2,12 L 5,15 M 22,12 L 19,9 M 22,12 L 19,15</Geometry>
        <Geometry x:Key="CopyIcon">M 8,8 L 19,8 L 19,19 L 8,19 Z M 5,14 L 5,5 L 14,5</Geometry>
        <Geometry x:Key="RotateIcon">M 20,12 A 8,8 0 1 1 12,4 L 12,1 L 16,4.5 L 12,8 L 12,4</Geometry>
        <Geometry x:Key="MirrorIcon">M 12,2 L 12,22 M 4,7 L 10,12 L 4,17 Z M 20,7 L 14,12 L 20,17 Z</Geometry>
        <Geometry x:Key="OffsetIcon">M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18</Geometry>
        <Geometry x:Key="TrimIcon">M 6,6 L 11,11 M 13,13 L 18,18 M 18,6 L 6,18 M 4,4 A 2.5,2.5 0 1 0 4,9 A 2.5,2.5 0 1 0 4,4 M 4,15 A 2.5,2.5 0 1 0 4,20 A 2.5,2.5 0 1 0 4,15</Geometry>
        <Geometry x:Key="ExtendIcon">M 19,3 L 19,21 M 3,12 L 17,12 M 13,8 L 17,12 L 13,16</Geometry>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Margin="4" HorizontalAlignment="Center">
        <TextBlock Text="CRIAR" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="4,4,4,6" HorizontalAlignment="Center" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource SelectIcon}" ToolTip="Selecionar entidades (Esc)" AutomationProperties.Name="Selecionar" Margin="2" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:CadToolType.Select}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource PanIcon}" ToolTip="Mover tela (Pan)" AutomationProperties.Name="Pan" Margin="2" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:CadToolType.Pan}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource LineIcon}" ToolTip="Desenhar linha: clique no início e no fim" AutomationProperties.Name="Linha" Margin="2" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:CadToolType.Line}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource PolylineIcon}" ToolTip="Desenhar polilinha: botão direito para concluir" AutomationProperties.Name="Polilinha" Margin="2" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:CadToolType.Polyline}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource RectangleIcon}" ToolTip="Desenhar retângulo: clique em dois cantos" AutomationProperties.Name="Retângulo" Margin="2" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:CadToolType.Rectangle}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource CircleIcon}" ToolTip="Desenhar círculo: clique no centro e no raio" AutomationProperties.Name="Círculo" Margin="2" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:CadToolType.Circle}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource ArcIcon}" ToolTip="Desenhar arco: centro, raio e ângulo final" AutomationProperties.Name="Arco" Margin="2" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:CadToolType.Arc}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource TextIcon}" ToolTip="Inserir texto: conteúdo, altura e ponto de inserção" AutomationProperties.Name="Texto" Margin="2" Command="{Binding AddTextPromptCommand}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource DimensionIcon}" ToolTip="Adicionar cota linear: escolha dois pontos e a posição" AutomationProperties.Name="Cota linear" Margin="2" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:CadToolType.Dimension}" />
        <Separator Background="#334155" Margin="4,8" />
        <TextBlock Text="EDITAR" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="4,0,4,6" HorizontalAlignment="Center" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource MoveIcon}" ToolTip="Mover: ponto base e destino; último clique conclui" AutomationProperties.Name="Mover" Margin="2" Command="{Binding MoveSelectedCommand}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource CopyIcon}" ToolTip="Copiar: ponto base e destino; último clique conclui" AutomationProperties.Name="Copiar" Margin="2" Command="{Binding CopySelectedCommand}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource RotateIcon}" ToolTip="Rotacionar: pivô, preview angular e direção final; R define referência" AutomationProperties.Name="Rotacionar" Margin="2" Command="{Binding RotateSelectedCommand}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource MirrorIcon}" ToolTip="Espelhar: eixo por dois pontos e escolha manter/substituir original" AutomationProperties.Name="Espelhar" Margin="2" Command="{Binding MirrorSelectedCommand}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource OffsetIcon}" ToolTip="Offset: distância digitada ou medida por dois pontos; clique no lado conclui" AutomationProperties.Name="Offset" Margin="2" Command="{Binding OffsetSelectedCommand}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource TrimIcon}" ToolTip="Aparar (Trim): selecione limites, Enter e clique no segmento a remover (TR)" AutomationProperties.Name="Aparar" Margin="2" Command="{Binding TrimSelectedCommand}" />
        <Button Style="{StaticResource CadIconButtonStyle}" Tag="{StaticResource ExtendIcon}" ToolTip="Estender (Extend): selecione limites, Enter e clique na extremidade a estender (EX)" AutomationProperties.Name="Estender" Margin="2" Command="{Binding ExtendSelectedCommand}" />
        <Separator Background="#334155" Margin="4,8" />
        <TextBlock Text="SNAPS" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="4,0,4,6" HorizontalAlignment="Center" />
        <ToggleButton Style="{StaticResource CadSnapToggleStyle}" Tag="{StaticResource OrthoIcon}" IsChecked="{Binding IsOrthoEnabled, Mode=OneWay}" ToolTip="Alternar desenho ortogonal (F8)" AutomationProperties.Name="Modo ortogonal" Margin="2" Command="{Binding ToggleOrthoCommand}" />
        <ToggleButton Style="{StaticResource CadSnapToggleStyle}" Tag="{StaticResource PolarIcon}" IsChecked="{Binding IsPolarEnabled, Mode=OneWay}" ToolTip="Alternar rastreamento polar (F10)" AutomationProperties.Name="Rastreamento polar" Margin="2" Command="{Binding TogglePolarCommand}" />
        <ToggleButton Style="{StaticResource CadSnapToggleStyle}" Tag="{StaticResource SnapIcon}" IsChecked="{Binding IsOsnapEnabled, Mode=OneWay}" ToolTip="Alternar captura de objetos (F3)" AutomationProperties.Name="Captura de objetos" Margin="2" Command="{Binding ToggleOsnapCommand}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
