<UserControl x:Class="DotNetCad.Demo.Controls.PropertyInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="Transparent" Foreground="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="PropLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,4,2" />
        </Style>

        <Style x:Key="PropValBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>

        <Style x:Key="PropCalcBoxStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="Background" Value="#162032" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>

        <Style x:Key="PropSectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,4">

            <!-- Validation Error Banner -->
            <Border Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="3"
                    Padding="6,4" Margin="0,0,0,6"
                    Visibility="{Binding ValidationError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ValidationError}" Foreground="#FCA5A5" FontSize="10" TextWrapping="Wrap" />
            </Border>

            <!-- 1. DOCUMENT SETTINGS (When 0 selected) -->
            <StackPanel Visibility="{Binding IsDocumentMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="PROPRIEDADES DO DESENHO" Style="{StaticResource PropSectionHeader}" />
                
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Arquivo:" Style="{StaticResource PropLabelStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DocumentTitle}" Style="{StaticResource PropCalcBoxStyle}" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Unidade:" Style="{StaticResource PropLabelStyle}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SupportedUnits}" SelectedItem="{Binding DisplayUnit, Mode=TwoWay}"
                              Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,2" Padding="4,2" FontSize="11" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Precisão:" Style="{StaticResource PropLabelStyle}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SupportedPrecisions}" SelectedItem="{Binding DecimalPrecision, Mode=TwoWay}"
                              Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,2" Padding="4,2" FontSize="11" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Entidades:" Style="{StaticResource PropLabelStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalEntitiesCount}" Style="{StaticResource PropCalcBoxStyle}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Camadas:" Style="{StaticResource PropLabelStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalLayersCount}" Style="{StaticResource PropCalcBoxStyle}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Dimensão:" Style="{StaticResource PropLabelStyle}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BoundingBoxSummary}" Style="{StaticResource PropCalcBoxStyle}" />
                </Grid>
                <TextBlock Text="Selecione uma entidade no desenho para editar suas propriedades." Foreground="#64748B" FontSize="9.5" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>

            <!-- 2. MULTIPLE ENTITIES (When > 1 selected) -->
            <StackPanel Visibility="{Binding IsMultipleEntitiesMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="SELEÇÃO MÚLTIPLA" Style="{StaticResource PropSectionHeader}" />
                <TextBlock Text="{Binding MultiSelectionSummary}" Foreground="#CBD5E1" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6" />

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Camada:" Style="{StaticResource PropLabelStyle}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableLayers}"
                              SelectedItem="{Binding CommonLayer, Mode=OneWay}"
                              SelectionChanged="OnBatchLayerChanged"
                              Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,2" Padding="4,2" FontSize="11" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cor:" Style="{StaticResource PropLabelStyle}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2">
                        <DockPanel LastChildFill="True">
                            <Border Width="18" Height="18" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"
                                    Background="{Binding CommonColorBrush}" BorderBrush="#94A3B8" BorderThickness="1"
                                    ToolTip="{Binding CommonColor, StringFormat={}Cor comum: {0}}" />
                            <ComboBox ItemsSource="{Binding ColorPalette}"
                                      SelectedValuePath="Hex"
                                      SelectedValue="{Binding CommonColor, Mode=OneWay}"
                                      SelectionChanged="OnBatchColorComboChanged"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,1">
                                            <Border Width="12" Height="12" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    Background="{Binding Hex}" BorderBrush="#94A3B8" BorderThickness="1" />
                                            <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Hex, StringFormat={} ({0})}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <!-- Quick color chips -->
                        <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="0,4,0,2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="15" Height="15" Margin="1,1" Padding="0" Cursor="Hand"
                                            Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Hex}"
                                            ToolTip="{Binding Name, StringFormat={}{0}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{Binding Hex}" BorderBrush="#475569" BorderThickness="1" CornerRadius="2" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 3. SINGLE ENTITY (When 1 selected) -->
            <StackPanel Visibility="{Binding IsSingleEntityMode, Converter={StaticResource BoolToVis}}">
                <!-- Header with Type & ID -->
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding EntityIdText}" Foreground="#64748B" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EntityTypeLabel}" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" />
                </DockPanel>

                <!-- General: Layer & Color -->
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Camada:" Style="{StaticResource PropLabelStyle}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableLayers}"
                              SelectedItem="{Binding SingleEntityLayer, Mode=TwoWay}"
                              Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,2" Padding="4,2" FontSize="11" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cor:" Style="{StaticResource PropLabelStyle}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2">
                        <DockPanel LastChildFill="True">
                            <Border Width="18" Height="18" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"
                                    Background="{Binding SingleEntityColor}" BorderBrush="#94A3B8" BorderThickness="1"
                                    ToolTip="{Binding SingleEntityColor, StringFormat={}Cor atual: {0}}" />
                            <TextBox DockPanel.Dock="Right" Width="68" Margin="4,0,0,0" Style="{StaticResource PropValBoxStyle}"
                                     Text="{Binding SingleEntityColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center" ToolTip="Código hexadecimal da cor (ex: #38BDF8)"
                                     KeyDown="PropBox_KeyDown" />
                            <ComboBox ItemsSource="{Binding ColorPalette}"
                                      SelectedValuePath="Hex"
                                      SelectedValue="{Binding SingleEntityColor, Mode=TwoWay}"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,1">
                                            <Border Width="12" Height="12" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    Background="{Binding Hex}" BorderBrush="#94A3B8" BorderThickness="1" />
                                            <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Hex, StringFormat={} ({0})}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <!-- Quick color chips -->
                        <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="0,4,0,2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="15" Height="15" Margin="1,1" Padding="0" Cursor="Hand"
                                            Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Hex}"
                                            ToolTip="{Binding Name, StringFormat={}{0}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{Binding Hex}" BorderBrush="#475569" BorderThickness="1" CornerRadius="2" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- LINE PROPERTIES -->
                <StackPanel Visibility="{Binding IsLine, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <TextBlock Text="GEOMETRIA DA LINHA" Style="{StaticResource PropSectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Início X:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LineX1, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Início Y:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LineY1, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fim X:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LineX2, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Fim Y:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LineY2, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Comprim.:" Style="{StaticResource PropLabelStyle}" ToolTip="Edita o comprimento mantendo o ponto inicial fixo" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LineLength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" ToolTip="Edita mantendo o ponto inicial" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Ângulo:" Style="{StaticResource PropLabelStyle}" ToolTip="Edita o ângulo mantendo o ponto inicial fixo" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LineAngle, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" ToolTip="Edita mantendo o ponto inicial" />
                    </Grid>
                </StackPanel>

                <!-- CIRCLE PROPERTIES -->
                <StackPanel Visibility="{Binding IsCircle, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <TextBlock Text="GEOMETRIA DO CÍRCULO" Style="{StaticResource PropSectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Centro X:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CircleCenterX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Centro Y:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CircleCenterY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Raio:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CircleRadius, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Diâmetro:" Style="{StaticResource PropLabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CircleDiameter}" Style="{StaticResource PropCalcBoxStyle}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Circunf.:" Style="{StaticResource PropLabelStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CircleCircumference}" Style="{StaticResource PropCalcBoxStyle}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Área:" Style="{StaticResource PropLabelStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CircleArea}" Style="{StaticResource PropCalcBoxStyle}" />
                    </Grid>
                </StackPanel>

                <!-- RECTANGLE PROPERTIES -->
                <StackPanel Visibility="{Binding IsRectangle, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <TextBlock Text="GEOMETRIA DO RETÂNGULO" Style="{StaticResource PropSectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Canto X:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RectX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Canto Y:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RectY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Largura:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RectWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Altura:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RectHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Área:" Style="{StaticResource PropLabelStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RectArea}" Style="{StaticResource PropCalcBoxStyle}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Perímetro:" Style="{StaticResource PropLabelStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RectPerimeter}" Style="{StaticResource PropCalcBoxStyle}" />
                    </Grid>
                </StackPanel>

                <!-- ARC PROPERTIES -->
                <StackPanel Visibility="{Binding IsArc, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <TextBlock Text="GEOMETRIA DO ARCO" Style="{StaticResource PropSectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Centro X:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ArcCenterX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Centro Y:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ArcCenterY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Raio:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ArcRadius, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ângulo Inic:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ArcStartAngle, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ângulo Fim:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ArcEndAngle, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Comprim.:" Style="{StaticResource PropLabelStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ArcLength}" Style="{StaticResource PropCalcBoxStyle}" />
                    </Grid>
                </StackPanel>

                <!-- TEXT PROPERTIES -->
                <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <TextBlock Text="CONTEÚDO E FORMATO DO TEXTO" Style="{StaticResource PropSectionHeader}" />
                    <TextBlock Text="Texto:" Style="{StaticResource PropLabelStyle}" />
                    <TextBox Text="{Binding TextContent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />
                    
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Altura:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TextHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Rotação:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TextRotation, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />
                    </Grid>
                </StackPanel>

                <!-- DIMENSION PROPERTIES -->
                <StackPanel Visibility="{Binding IsDimension, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <TextBlock Text="PROPRIEDADES DA COTA" Style="{StaticResource PropSectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Medido:" Style="{StaticResource PropLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DimMeasuredLength}" Style="{StaticResource PropCalcBoxStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Prefixo:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DimPrefix, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sufixo:" Style="{StaticResource PropLabelStyle}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DimSuffix, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropValBoxStyle}" KeyDown="PropBox_KeyDown" />
                    </Grid>
                    <TextBlock Text="Cota estática geométrica (sem vínculo associativo paramétrico)." Foreground="#64748B" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
