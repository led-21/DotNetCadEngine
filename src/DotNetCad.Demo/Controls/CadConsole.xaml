<UserControl x:Class="DotNetCad.Demo.Controls.CadConsole"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#111C2E">
 <UserControl.Resources>
  <Style x:Key="ConsoleToggleStyle" TargetType="ToggleButton">
   <Setter Property="Background" Value="#172033"/>
   <Setter Property="Foreground" Value="#E2E8F0"/>
   <Setter Property="BorderBrush" Value="#334155"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#1E293B"/><Setter Property="BorderBrush" Value="#38BDF8"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#273549"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#334155"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#38BDF8"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#1E293B"/><Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="BorderBrush" Value="#475569"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#334155"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#38BDF8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0F172A"/><Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="Padding" Value="4,2"/></Style>
 </UserControl.Resources>
 <Grid Margin="8,2">
  <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0">
   <Button DockPanel.Dock="Right" Content="✕" ToolTip="Ocultar console (F2)" Command="{Binding ToggleConsoleCommand}" Padding="6,0" Margin="4,0" FontWeight="Bold" Foreground="#94A3B8"/>
   <Button DockPanel.Dock="Right" x:Name="NewMessages" Content="Novas mensagens" Visibility="Collapsed" Click="ShowNewMessages" Padding="6,0"/>
   <Button DockPanel.Dock="Right" Content="Cancelar operação" Click="CancelOperation" ToolTip="Cancelar preview no viewport; a entrada abaixo sempre inicia um novo comando" Padding="6,0" Margin="4,0"/>
   <ToggleButton x:Name="HistoryToggle" Style="{StaticResource ConsoleToggleStyle}" Content="Console" IsChecked="True" Checked="ToggleHistory" Unchecked="ToggleHistory" ToolTip="Mostrar ou ocultar o histórico de comandos e mensagens. A linha de entrada permanece disponível." HorizontalAlignment="Left" Padding="6,0">
    <ToggleButton.ContextMenu><ContextMenu><MenuItem Header="Restaurar tamanho do console" Click="ResetSize"/></ContextMenu></ToggleButton.ContextMenu>
   </ToggleButton>
  </DockPanel>
  <DockPanel Grid.Row="1" x:Name="HistoryBody" Margin="0,3,0,3">
   <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,3">
    <TextBox x:Name="Search" Width="150" TextChanged="FilterChanged" ToolTip="Pesquisar no texto, origem ou severidade"/>
    <CheckBox x:Name="ErrorsOnly" Content="Só erros" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="6,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
    <Button Content="Copiar seleção" Click="CopySelected" Padding="5,0" Margin="2,0"/>
    <Button Content="Exportar…" Click="ExportLog" ToolTip="Exportar explicitamente as mensagens filtradas para arquivo de texto" Padding="5,0" Margin="2,0"/>
    <Button Content="Limpar mensagens" Click="ClearMessages" ToolTip="Limpar apenas o console; não altera desenho nem undo" Padding="5,0" Margin="2,0"/>
   </WrapPanel>
   <ListBox x:Name="Output" Background="#0F172A" Foreground="#CBD5E1" BorderThickness="0" SelectionMode="Extended"
     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.ScrollChanged="OutputScrolled">
    <ListBox.ContextMenu><ContextMenu><MenuItem Header="Copiar mensagens selecionadas" Click="CopySelected"/><MenuItem Header="Copiar comando selecionado" Click="CopyCommand"/></ContextMenu></ListBox.ContextMenu>
    <ListBox.ItemTemplate><DataTemplate>
     <TextBox Text="{Binding Display, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0" Background="Transparent" Foreground="#CBD5E1" FontFamily="Consolas" FontSize="11" Padding="0" TextWrapping="NoWrap"/>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel>
  <TextBlock Grid.Row="2" x:Name="ArgumentHelp" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  <DockPanel Grid.Row="3">
   <Button DockPanel.Dock="Right" Content="Executar" Click="Execute" Padding="6,2" Margin="4,0,0,0"/>
   <TextBox x:Name="Input" Text="{Binding ConsoleInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" MaxLength="8192" VerticalContentAlignment="Center" PreviewKeyDown="InputKeyDown" TextChanged="InputChanged" ToolTip="Novo comando CAD: Enter executa, ↑/↓ histórico, Tab completa. Operação interativa recebe pontos no viewport."/>
  </DockPanel>
 </Grid>
</UserControl>
