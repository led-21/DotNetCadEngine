<Window x:Class="DotNetCad.Demo.Views.SplashScreenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DotNetCadEngine — Inicializando"
        Width="640" Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDarkBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#64748B" />

        <Style x:Key="TechProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer card with subtle technical border and drop shadow -->
    <Border Margin="16" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1.5" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" Opacity="0.55" Direction="270" ShadowDepth="4" RenderingBias="Quality" />
        </Border.Effect>

        <Grid ClipToBounds="True">
            <!-- Background Subtle Engineering Grid (Vector DrawingBrush) -->
            <Grid.Background>
                <DrawingBrush Viewport="0,0,24,24" ViewportUnits="Absolute" TileMode="Tile" Opacity="0.18">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Geometry="M 0,0 L 24,0 24,24 0,24 Z">
                                <GeometryDrawing.Brush>
                                    <SolidColorBrush Color="#0F172A" />
                                </GeometryDrawing.Brush>
                            </GeometryDrawing>
                            <GeometryDrawing Geometry="M 0,0 L 24,0 M 0,0 L 0,24">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#38BDF8" Thickness="0.5" />
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                            <GeometryDrawing Geometry="M 0,0 A 0.75,0.75 0 1 1 0.01,0">
                                <GeometryDrawing.Brush>
                                    <SolidColorBrush Color="#38BDF8" />
                                </GeometryDrawing.Brush>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Grid.Background>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Brand, Identity & Startup Status -->
            <DockPanel Grid.Column="0" Margin="28,24,16,20" LastChildFill="True">
                <!-- Top Brand Header -->
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="CAD 2D" Foreground="{StaticResource CyanAccentBrush}" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI" />
                        </Border>
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="MOTOR VETORIAL" Foreground="#93C5FD" FontSize="9" FontWeight="SemiBold" FontFamily="Segoe UI" />
                        </Border>
                    </StackPanel>

                    <!-- Application Title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="DotNetCad" Foreground="{StaticResource CyanAccentBrush}" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI" />
                        <TextBlock Text="Engine" Foreground="{StaticResource TextPrimaryBrush}" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI" Margin="4,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="Geometria Vetorial, DXF &amp; Protocolo MCP"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontFamily="Segoe UI" Margin="0,0,0,4" />

                    <!-- Version String -->
                    <TextBlock x:Name="TxtVersion" Text="v1.0.0 (x64 Windows)"
                               Foreground="{StaticResource TextDimBrush}" FontSize="11" FontFamily="Consolas" Margin="0,0,0,12" />
                </StackPanel>

                <!-- Bottom Status Indicator & Progress -->
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                        <TextBlock x:Name="TxtStatus" Text="Inicializando subsistemas..."
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ProgressBar x:Name="StartupProgress" Style="{StaticResource TechProgressBarStyle}"
                                 IsIndeterminate="True" Height="4" Margin="0,0,0,8" />

                    <DockPanel LastChildFill="True">
                        <TextBlock Text="Desenvolvido em C# / WPF (.NET 10)"
                                   Foreground="{StaticResource TextDimBrush}" FontSize="9.5" FontFamily="Segoe UI" />
                        <TextBlock Text="Local Offline" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextDimBrush}" FontSize="9.5" FontFamily="Segoe UI" />
                    </DockPanel>
                </StackPanel>

                <!-- Middle Description spacer -->
                <Grid />
            </DockPanel>

            <!-- RIGHT PANEL: Precision CAD Monogram & Technical Drafting Geometry -->
            <Canvas Grid.Column="1" Margin="8,16,16,16" ClipToBounds="True" Opacity="0.9">
                <!-- Coordinate Axes (X and Y with arrows) -->
                <Path Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeDashArray="6 3"
                      Data="M 20,270 L 240,270 M 50,290 L 50,20" />
                <TextBlock Text="X" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontFamily="Consolas" Canvas.Left="232" Canvas.Top="274" />
                <TextBlock Text="Y" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontFamily="Consolas" Canvas.Left="38" Canvas.Top="14" />

                <!-- Concentric Drafting Compass Dial Arcs -->
                <Path Stroke="{StaticResource CyanAccentBrush}" StrokeThickness="1" StrokeDashArray="3 5" Opacity="0.3"
                      Data="M 50,270 A 170,170 0 0,1 220,100" />
                <Path Stroke="{StaticResource TextDimBrush}" StrokeThickness="0.8" StrokeDashArray="2 4" Opacity="0.25"
                      Data="M 50,270 A 120,120 0 0,1 170,150" />

                <!-- Dark Backing Facet -->
                <Path Fill="#162032" Stroke="{StaticResource BorderBrush}" StrokeThickness="1.5" Opacity="0.8"
                      Data="M 70,70 L 130,70 C 180,70 210,105 210,155 C 210,205 180,240 130,240 L 70,240 Z" />

                <!-- Inner Triangular Viewport Void -->
                <Path Fill="#0A0F1D" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"
                      Data="M 106,110 L 128,110 C 152,110 168,128 168,155 C 168,182 152,200 128,200 L 106,200 Z" />

                <!-- Diagonal Engineering Truss Strut (45 degrees) -->
                <Line X1="74" Y1="236" X2="180" Y2="130" Stroke="#0284C7" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line X1="74" Y1="236" X2="180" Y2="130" Stroke="#7DD3FC" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8" />

                <!-- Sweeping Precision CAD Arc Ribbon -->
                <Path Stroke="{StaticResource CyanAccentBrush}" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 86,72 C 180,72 216,110 216,155 C 216,200 180,238 86,238" />
                <!-- Inner Arc Highlight Filament -->
                <Path Stroke="#E0F2FE" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9"
                      Data="M 92,76 C 174,76 208,112 208,155 C 208,198 174,234 92,234" />

                <!-- Vertical Primary Ruler Spine -->
                <Border Background="{StaticResource CyanAccentBrush}" BorderBrush="#E0F2FE" BorderThickness="1.5"
                        CornerRadius="4" Width="22" Height="176" Canvas.Left="64" Canvas.Top="67" />

                <!-- Ruler Precision Graduation Ticks -->
                <Line X1="64" Y1="85" X2="76" Y2="85" Stroke="#0369A1" StrokeThickness="2" />
                <Line X1="64" Y1="105" X2="72" Y2="105" Stroke="#0369A1" StrokeThickness="1.5" />
                <Line X1="64" Y1="125" X2="76" Y2="125" Stroke="#0369A1" StrokeThickness="2" />
                <Line X1="64" Y1="145" X2="72" Y2="145" Stroke="#0369A1" StrokeThickness="1.5" />
                <Line X1="64" Y1="165" X2="76" Y2="165" Stroke="#0369A1" StrokeThickness="2" />
                <Line X1="64" Y1="185" X2="72" Y2="185" Stroke="#0369A1" StrokeThickness="1.5" />
                <Line X1="64" Y1="205" X2="76" Y2="205" Stroke="#0369A1" StrokeThickness="2" />
                <Line X1="64" Y1="225" X2="72" Y2="225" Stroke="#0369A1" StrokeThickness="1.5" />

                <!-- Precision Snap Nodes (Luminous Geometric Anchors) -->
                <!-- Top Anchor Snap Node -->
                <Rectangle Width="10" Height="10" Fill="{StaticResource TextPrimaryBrush}" Stroke="#0284C7" StrokeThickness="2" Canvas.Left="81" Canvas.Top="67" />
                <!-- Apex Snap Node (Intersection Point) -->
                <Ellipse Width="12" Height="12" Fill="{StaticResource TextPrimaryBrush}" Stroke="#0284C7" StrokeThickness="2" Canvas.Left="210" Canvas.Top="149" />
                <Ellipse Width="4" Height="4" Fill="{StaticResource CyanAccentBrush}" Canvas.Left="214" Canvas.Top="153" />
                <!-- Bottom Anchor Snap Node -->
                <Rectangle Width="10" Height="10" Fill="{StaticResource TextPrimaryBrush}" Stroke="#0284C7" StrokeThickness="2" Canvas.Left="81" Canvas.Top="233" />
                <!-- Strut Snap Node -->
                <Ellipse Width="8" Height="8" Fill="{StaticResource TextPrimaryBrush}" Stroke="#0284C7" StrokeThickness="1.5" Canvas.Left="176" Canvas.Top="126" />

                <!-- Dimension Line with arrows and measurement text -->
                <Line X1="50" Y1="256" X2="216" Y2="256" Stroke="{StaticResource CyanAccentBrush}" StrokeThickness="1" />
                <Line X1="50" Y1="250" X2="50" Y2="262" Stroke="{StaticResource CyanAccentBrush}" StrokeThickness="1" />
                <Line X1="216" Y1="250" X2="216" Y2="262" Stroke="{StaticResource CyanAccentBrush}" StrokeThickness="1" />
                <!-- Left Arrow -->
                <Path Fill="{StaticResource CyanAccentBrush}" Data="M 50,256 L 58,253 L 58,259 Z" />
                <!-- Right Arrow -->
                <Path Fill="{StaticResource CyanAccentBrush}" Data="M 216,256 L 208,253 L 208,259 Z" />
                <Border Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="4,1" Canvas.Left="106" Canvas.Top="248">
                    <TextBlock Text="R 45.000 mm" Foreground="{StaticResource CyanAccentBrush}" FontSize="9" FontFamily="Consolas" FontWeight="SemiBold" />
                </Border>

                <!-- Technical Badge Annotation in technical style -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="2" Padding="4,2" Canvas.Left="144" Canvas.Top="38" Opacity="0.9">
                    <TextBlock Text="DXF / SVG / CAD" Foreground="{StaticResource TextMutedBrush}" FontSize="8.5" FontFamily="Consolas" />
                </Border>
            </Canvas>
        </Grid>
    </Border>
</Window>
