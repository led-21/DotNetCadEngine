<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DotNetCad.Demo</AssemblyName>
    <RootNamespace>DotNetCad.Demo</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\dotnetcad.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\dotnetcad.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetCad.Core\DotNetCad.Core.csproj" />
    <ProjectReference Include="..\DotNetCad.Infrastructure\DotNetCad.Infrastructure.csproj" />
  </ItemGroup>

</Project>
